{
  "name": "@superagent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/main.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate",
    "test:live": "vitest run --project live"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.81",
    "@hono/node-server": "1.19.17",
    "@hono/zod-openapi": "1.6.3",
    "@mastra/core": "1.74.0",
    "@mastra/hono": "1.7.16",
    "@mastra/loggers": "1.3.4",
    "@mastra/memory": "1.35.0",
    "@mastra/pg": "1.29.0",
    "@scalar/hono-api-reference": "0.12.10",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mastra/libsql": "1.25.0",
    "@superagent/shared": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "ai": "7.0.130",
    "drizzle-kit": "0.31.11",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
