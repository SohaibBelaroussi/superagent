# Copy to .env and fill in. .env is gitignored.
# Generate secrets with:
#   node -e "console.log('sa_' + require('crypto').randomBytes(32).toString('base64url'))"

# --- Postgres (docker compose) ---
# Letters, digits, - and _ only: it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://superagent:change-me@localhost:5432/superagent

# --- API server ---
HOST=127.0.0.1
PORT=4111
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Qatar
# Bootstrap token: always valid, used to create device tokens. At least 32 characters.
SUPERAGENT_ADMIN_TOKEN=
# Encrypts provider API keys at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes stored provider keys unreadable.
SUPERAGENT_ENCRYPTION_KEY=
# Token for Mastra Studio (pnpm studio). Leave empty to disable Studio login.
STUDIO_TOKEN=
# Comma-separated browser origins allowed to call the API (Studio runs on :3000).
CORS_ORIGINS=http://localhost:3000
MASTRA_TELEMETRY_DISABLED=true
# Host port for the packaged API container (docker compose --profile app).
API_PORT=4112

# --- Web tools (M2): SearXNG search and Crawl4AI page fetching (docker compose services) ---
# Crawl4AI only accepts outside connections when this token is set: openssl rand -hex 32
CRAWL4AI_API_TOKEN=
SEARXNG_SECRET=
# The dev server reaches them on these host ports; the packaged API uses the compose service names.
SEARXNG_URL=http://127.0.0.1:8888
CRAWL4AI_URL=http://127.0.0.1:11235

# --- Live LLM tests (M1). Put your provider key here, never in chat or git. ---
LIVE_LLM_BASE_URL=https://your-provider.example/v1
LIVE_LLM_API_KEY=
LIVE_LLM_MODEL=
LIVE_LLM_FAST_MODEL=
LIVE_LLM_EMBEDDING_MODEL=

# Object storage for uploaded documents (SeaweedFS's S3 API). Generate both, for example:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key-at-least-16
# S3_ENDPOINT=http://127.0.0.1:8333   (the default; compose sets the in-network address for the API)
# S3_PORT=8333

# Long threads are compressed into observations past this many tokens (defaults shown).
# MEMORY_OBSERVE_TOKENS=30000
# MEMORY_REFLECT_TOKENS=40000
