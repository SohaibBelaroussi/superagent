# Copy to .env and fill in. .env is gitignored.
# Generate secrets with:
#   node -e "console.log('sa_' + require('crypto').randomBytes(32).toString('base64url'))"

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgres://superagent:change-me@localhost:5432/superagent

# --- API server ---
HOST=127.0.0.1
PORT=4111
LOG_LEVEL=info
DEFAULT_TIMEZONE=Asia/Qatar
# Bootstrap token: always valid, used to create device tokens. At least 32 characters.
SUPERAGENT_ADMIN_TOKEN=
# Token for Mastra Studio (pnpm studio). Leave empty to disable Studio login.
STUDIO_TOKEN=
# Comma-separated browser origins allowed to call the API (Studio runs on :3000).
CORS_ORIGINS=http://localhost:3000
MASTRA_TELEMETRY_DISABLED=true
# Host port for the packaged API container (docker compose --profile app).
API_PORT=4112

# --- Live LLM tests (M1). Put your provider key here, never in chat or git. ---
LIVE_LLM_BASE_URL=https://your-provider.example/v1
LIVE_LLM_API_KEY=
LIVE_LLM_MODEL=
LIVE_LLM_FAST_MODEL=
LIVE_LLM_EMBEDDING_MODEL=
